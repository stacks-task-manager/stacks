        vi.clearAllMocks();
        vi.mocked(getCurrentUser).mockReturnValue({
            id: ownerId,
            tenant: "tenant-1",
            admin: false,
        } as any);
        vi.mocked(TasksLoader.getAll).mockResolvedValue([{ id: taskId }] as any);
        updateMock.mockResolvedValue([1] as any);
        notificationAddMock.mockResolvedValue({} as any);
