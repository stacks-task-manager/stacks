# Email Service Dockerfile
FROM node:20-bullseye

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /email-service

# Copy package files and install dependencies
COPY email-service/package.json ./
RUN yarn install --production

# Copy the bundled email service
COPY email-service/ .

# Remove any existing node_modules and reinstall to ensure compatibility
RUN rm -rf node_modules && yarn install --production

# AGPL-3.0 — ship LICENSE + NOTICE alongside the binary.
COPY email-service/LICENSE /email-service/LICENSE
COPY email-service/NOTICE /email-service/NOTICE

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD node -e "process.exit(0)"

# Start the email service
CMD ["node", "email-service.js"]
</file>

<file path="docker/Dockerfile.migration">
# Migration Dockerfile
# This container runs database migrations before other services start

FROM node:18-alpine

# Set working directory
WORKDIR /db

# Install dependencies for PostgreSQL client
RUN apk add --no-cache postgresql-client

# Full db/ artifact (package.json, vendor/stacks-types, migrations, …) from `yarn release:db`
COPY db ./

# AGPL-3.0 — ship LICENSE + NOTICE alongside the binary.
COPY db/LICENSE /db/LICENSE
COPY db/NOTICE /db/NOTICE

RUN yarn install --production

# Wait for database to be ready and run migrations
CMD ["sh", "-c", "while ! pg_isready -h $POSTGRES_HOST -p $POSTGRES_PORT -U $POSTGRES_USER; do echo 'Waiting for database...'; sleep 2; done && echo 'Database is ready, running migrations...' && npm run migrate"]
</file>

