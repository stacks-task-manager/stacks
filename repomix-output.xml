            <Switch
                label={translate("Only show assigned tasks")}
                checked={Boolean(onlyAssigned)}
                disabled={disabled}
                onChange={() => ProjectFiltersActions.set("onlyAssigned", !onlyAssigned)}
            />
        </>
    );
};

