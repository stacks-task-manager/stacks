    gap: 10px;
    outline: none;

    :first-child {
        margin-top: 0;
    }

    p {
        margin-bottom: 0;
    }

    /* Links */
    a {
        cursor: text;
    }

    /* Headers */
    h1,
    h2,
    h3 {
        margin: 0;
    }

    /* List styles */
    ul,
    ol {
        padding: 0 1rem;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    /* Task list specific styles */
    ul[data-type="taskList"] {
        list-style: none;
        margin-left: 0;
        padding: 0;

        li {
            display: flex;
            align-items: flex-start;

            > label {
                flex: 0 0 auto;
                margin-right: 0.5rem;
                padding-top: 3px;
                user-select: none;
                display: inline-flex;
            }

            > div {
                display: flex;
                flex-direction: column;
                gap: 4px;
            }

            &[data-checked="true"] {
                text-decoration: line-through;
            }
        }

        input[type="checkbox"] {
            cursor: pointer;
        }
    }

    /* Code block */
    pre {
        background: $dark-gray2;
        border-radius: 0.5rem;
        color: $white;
        font-family: "JetBrainsMono", monospace;
        margin: 0;
        padding: 0.75rem 1rem;
        overflow: auto;

        code {
            background: none;
            color: inherit;
            font-size: 0.8rem;
            padding: 0;
        }
    }

    /* Code styling */
    .hljs-comment,
    .hljs-quote {
        color: #616161;
    }

    .hljs-variable,
    .hljs-template-variable,
    .hljs-attribute,
    .hljs-tag,
    .hljs-name,
    .hljs-regexp,
    .hljs-link,
    .hljs-name,
    .hljs-selector-id,
    .hljs-selector-class {
        color: #f98181;
    }

    .hljs-number,
    .hljs-meta,
    .hljs-built_in,
    .hljs-builtin-name,
    .hljs-literal,
    .hljs-type,
    .hljs-params {
        color: #fbbc88;
    }

    .hljs-string,
    .hljs-symbol,
    .hljs-bullet {
        color: #b9f18d;
    }

    .hljs-title,
    .hljs-section {
        color: #faf594;
    }

    .hljs-keyword,
    .hljs-selector-tag {
        color: #70cff8;
    }

    .hljs-emphasis {
        font-style: italic;
    }

    .hljs-strong {
        font-weight: 700;
    }

    .code-block {
        position: relative;

        select {
            position: absolute;
            right: 10px;
            top: 10px;
        }
    }

    blockquote {
        border-left: 3px solid #ccc;
        margin: 1.5rem 0;
        padding-left: 1rem;
        margin-bottom: 0;
    }

    /* Mentions */
    .mention,
    .document,
    .file-attachment {
        border-radius: 10px;
        box-decoration-break: clone;
        padding: 0 5px;
        cursor: pointer;
        position: relative;

        &:hover {
            text-decoration: none;
        }

        .#{$ns}-icon {
            position: absolute;
            left: 3px;
            top: 2px;
        }
    }

    .mention {
        background-color: rgba(88, 5, 255, 0.05);
        color: #6a00f5;
        padding-left: 17px;
    }

    .document {
        background-color: rgba(0, 119, 182, 0.1);
        color: #023e8a;
        padding-left: 20px;
    }

    .file-attachment {
        background-color: rgba(230, 57, 70, 0.1);
        color: #780000;
        padding-left: 20px;

        small {
            margin-left: 5px;
        }
    }

    /* Mark */
    mark {
        background-color: #faf594;
        border-radius: 0.4rem;
        box-decoration-break: clone;
        padding: 0.1rem 0.3rem;
    }

    /* Table-specific styling */
    table {
        border-collapse: collapse;
        margin: 0;
        overflow: hidden;
        table-layout: fixed;
        width: 100%;

        td,
        th {
            border: 1px solid $light-gray1;
            box-sizing: border-box;
            min-width: 1em;
            padding: 6px 8px;
            position: relative;
            vertical-align: top;

            > * {
                margin-bottom: 0;
            }
        }

        th {
            background-color: $light-gray3;
            font-weight: bold;
            text-align: left;
        }

        .selectedCell:after {
            background: $light-gray4;
            content: "";
            left: 0;
            right: 0;
            top: 0;
            bottom: 0;
            pointer-events: none;
            position: absolute;
            z-index: 2;
        }

        .column-resize-handle {
            background-color: $indigo3;
            bottom: -2px;
            pointer-events: none;
            position: absolute;
            right: -2px;
            top: 0;
            width: 4px;
        }
    }

    .tableWrapper {
        // margin: 1.5rem 0;
        overflow-x: auto;
    }

    &.resize-cursor {
        cursor: ew-resize;
        cursor: col-resize;
    }

    hr {
        border: none;
        border-top: 1px solid $light-gray3;
        cursor: pointer;
        margin: 1.5rem 0;

        &.ProseMirror-selectednode {
            border-top: 1px solid $indigo1;
        }
    }

    p.is-editor-empty:first-child::before {
        color: $gray3;
        content: attr(data-placeholder);
        float: left;
        height: 0;
        pointer-events: none;
    }

    /* Callout */
    .callout {
        border-radius: 2px;
        line-height: 1.5;
        padding: 15px;
        position: relative;
        width: 100%;

        &.primary {
            color: $pt-intent-primary;
            background-color: rgba($pt-intent-primary, 0.1);
        }

        &.success {
            color: $pt-intent-success;
            background-color: rgba($pt-intent-success, 0.1);
        }

        &.warning {
            color: $pt-intent-warning;
            background-color: rgba($pt-intent-warning, 0.1);
        }

        &.danger {
            color: $pt-intent-danger;
            background-color: rgba($pt-intent-danger, 0.1);
        }
    }
}

/* Toolbar */
.tiptap-toolbar {
    display: flex;
    align-items: center;

    &-spring {
        flex-grow: 2;
    }

    &-separator {
        height: 15px;
        margin-left: 5px;
        margin-right: 5px;
        width: 1px;
        background-color: $light-gray1;
    }

    .#{$ns}-button {
        outline: none;
    }
}

.tiptap-mentions-container {
    position: fixed;
}

/* Bubble menu */
.tiptap-bubble-menu {
    .#{$ns}-button-group {
        align-items: center;
    }

    &-link {
        display: flex;
        align-items: center;
        gap: 10px;
        padding-left: 5px;

        a {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            display: block;
            max-width: 150px;
        }
    }
}

/* Resizable image/iframe */
.tiptap-image-resize {
    display: flex;

    &.align-left {
        justify-content: flex-start;

        .tiptap-resize-handle {
            right: 5px;
        }
    }

    &.align-center {
        justify-content: center;

        .tiptap-resize-handle {
            left: 50%;
            transform: translateX(-50%);
        }
    }

    &.align-right {
        justify-content: flex-end;

        .tiptap-resize-handle {
            left: 5px;
        }
    }

    &.error {
        .tiptap-image-resize-wrapper {
            background-color: $light-gray3;
            min-height: 300px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .#{$ns}-icon {
            opacity: 0.5;
        }

        .tiptap-resize-handle {
            display: none;
        }
    }

    .tiptap-info-button {
        position: absolute;
        top: 10px;
        right: 10px;
        border-radius: 50%;
        transition: all 0.2s;

        &:not(.#{$ns}-active) {
            opacity: 0;
        }
    }

    &:hover {
        .tiptap-info-button {
            opacity: 1;
        }
    }
}

.tiptap-iframe-resize-wrapper {
    width: 100%;
    outline: 1px solid $light-gray1;
    margin: 0;
    box-shadow: none;

    iframe,
    webview {
        width: 100%;
        user-select: none;
    }
}

.tiptap-image-resize-wrapper,
.tiptap-iframe-resize-wrapper {
    position: relative;
    max-width: 100%;
    display: flex;
    overflow: hidden;
    border-radius: 5px;

    .tiptap-image-resize-align {
        position: absolute;
        top: 10px;
        left: 50%;
        transform: translateX(-50%);
    }

    img {
        max-width: 100%;
        width: 100%;
    }

    .tiptap-resize-handle {
        position: absolute;
        bottom: 5px;
        height: 27px;
        width: 27px;
        cursor: grab;
    }

    .tiptap-image-resize-align,
    .tiptap-resize-handle {
        opacity: 0;
        transition: all 0.2s ease-in-out;
    }

    &:hover {
        .tiptap-resize-handle,
        .tiptap-image-resize-align {
            opacity: 1;
        }
    }
}

.tiptap-iframe-resize {
    justify-content: flex-start;

    .tiptap-iframe-resize-wrapper {
        flex-direction: column;

        webview {
            flex-grow: 2;
        }
    }

    .tiptap-iframe-mouse-block {
        position: absolute;
        background-color: rgba(0, 0, 0, 0.3);
        top: 0;
        bottom: 0;
        left: 0;
        right: 0;
        display: none;
    }

    &.resizing {
        .tiptap-iframe-mouse-block {
            display: block;
        }
    }

    .tiptap-resize-handle {
        width: 30px;
        height: 30px;
        right: 0;
        bottom: 0;
    }
}
.ProseMirror-focused {
    .node-image,
    .node-webview {
        &.ProseMirror-selectednode {
            .tiptap-image-resize-wrapper,
            .tiptap-iframe-resize-wrapper {
                outline: 3px solid $blue3;
            }
        }
    }
}

/* Confidential */
.node-confidential {
    display: inline;
}
.tiptap-confidential {
    color: $red3;
    font-weight: bold;
    cursor: help;
}

.tiptap-confidential-popup {
    textarea {
        resize: none;
    }
}

.html-renderer {
    &.break {
        word-break: break-all;
    }
}

.tiptap-view-more {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    display: flex;
    justify-content: center;
    z-index: 10;

    &::before {
        content: "";
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 100px;
        background: $white;
        background: linear-gradient(0deg, $white 20%, rgba(255, 255, 255, 0) 100%);
        z-index: -1;
    }
}

.#{$ns}-dark {
    .tiptap-toolbar {
        background-color: $dark-gray4;

        &::before {
            background-color: $gray1;
        }
    }

    .tiptap {
        .mention {
            background-color: #c8b6eb;
        }

        .document {
            background-color: #add4e9;
        }

        .file-attachment {
            background-color: #f5bcbe;
        }
    }

    .tiptap-view-more {
        &::before {
            background: $dark-gray3;
            background: linear-gradient(0deg, $dark-gray3 20%, rgba(255, 255, 255, 0) 100%);
        }
    }
}
