                        </div>
                    }
                >
                    <Button variant="minimal" size="small" icon={<Icon icon="info-circle" size={14} />} />
                </Popover>
                <Popover
                    content={
                        <FileMenu
                            attachmentId={file.id}
                            canDelete={canDelete}
                            onDelete={handleDelete}
                            prepend={
                                <>
                                    {Boolean(onOpenTask) ? (
                                        <React.Fragment>
                                            <MenuItem
