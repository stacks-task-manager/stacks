 */
projects.get(
    "/:id/stacks",
    cacheMiddleware({ ttl: 300 }),
    asyncHandler(async (c: Context) => {
        const { id } = c.req.param();
        parseUuidParam(id);

        const stacks = await StacksLoader.getAll(id);
        return c.replySuccess(stacks);
    })
);

/**
 * Update a project by ID.
