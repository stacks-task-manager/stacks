    value: string | number;
    hint?: string;
    intent?: "default" | "done" | "idle" | "danger";
}) {
    const accent =
        intent === "done"
            ? "text-emerald-600"
            : intent === "danger"
            ? "text-error-600"
            : intent === "idle"
            ? "text-typography-500"
            : "text-typography-900";
    return (
