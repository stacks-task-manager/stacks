.attachment {
    border-radius: 3px;
    border: 1px solid $light-gray3;
    padding: 10px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    width: 100%;
    position: relative;

    &__toolbar {
        position: absolute;
        top: 5px;
        left: 8px;
        right: 8px;
        display: flex;
        justify-content: space-between;

        .#{$ns}-button {
            opacity: 0.3;
            min-height: 16px;
            min-width: 16px;
        }
    }

    &__content {
        min-width: 0;
        flex-grow: 2;
    }

    &__icon {
        flex-shrink: 0;
        border-radius: 3px;
        background-color: $light-gray3;
        height: 80px;
