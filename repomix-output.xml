            (function () {
                var btn = document.getElementById("mobileMenuBtn");
                var menu = document.getElementById("mobileMenu");
                if (!btn || !menu) return;
                btn.addEventListener("click", function () {
                    var open = menu.classList.toggle("d-flex");
                    menu.classList.toggle("d-none", !open);
                    menu.toggleAttribute("hidden", !open);
                    btn.setAttribute("aria-expanded", open ? "true" : "false");
                });
            })();
            (function () {
                var items = document.querySelectorAll(".reveal");
                if (
                    !("IntersectionObserver" in window) ||
                    window.matchMedia("(prefers-reduced-motion: reduce)").matches
                ) {
                    items.forEach(function (item) {
                        item.classList.add("is-visible");
                    });
                    return;
                }
                var observer = new IntersectionObserver(
                    function (entries) {
                        entries.forEach(function (entry) {
                            if (entry.isIntersecting) {
                                entry.target.classList.add("is-visible");
                                observer.unobserve(entry.target);
                            }
                        });
                    },
                    { threshold: 0.12 }
                );
                items.forEach(function (item) {
                    observer.observe(item);
                });
            })();
            document.querySelectorAll('a[href^="#"]').forEach(function (a) {
                a.addEventListener("click", function (e) {
                    var id = a.getAttribute("href");
                    if (id && id !== "#") {
                        var el = document.querySelector(id);
                        if (el) {
                            e.preventDefault();
                            el.scrollIntoView({ behavior: "smooth" });
                        }
                    }
                    var mEl = document.getElementById("mobileMenu");
                    var bEl = document.getElementById("mobileMenuBtn");
                    if (mEl && mEl.classList.contains("d-flex")) {
                        mEl.classList.remove("d-flex");
                        mEl.classList.add("d-none");
                        mEl.setAttribute("hidden", "");
                        if (bEl) bEl.setAttribute("aria-expanded", "false");
                    }
                });
            });
        </script>
    </body>
</html>
