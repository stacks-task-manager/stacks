      <rect
        x={left}
        y="0"
        width={width}
        height={bodyScrollHeight}
        strokeWidth="0"
      />
      {rightLine && <path d={`M${right},0 L${right},${bodyScrollHeight}`} />}
    </g>
  );
};
export default observer(DragPresent);
