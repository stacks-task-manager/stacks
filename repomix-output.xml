interface ITaskDetailsSectionProps {
    title?: string | React.ReactNode;
    vertical?: boolean;
    centered?: boolean;
    align?: "center" | "right";
    children?: React.ReactNode;
    accessory?: React.ReactNode;
    gap?: number;
    width?: number;
    className?: string;
    isLoading?: boolean;
}
export const TaskDetailsSection: FunctionComponent<ITaskDetailsSectionProps> = ({
    title,
    vertical,
    centered,
    align,
    children,
    accessory,
