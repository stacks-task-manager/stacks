const timelog = (id: string, overrides: Record<string, unknown> = {}) => ({
    id,
    project: projectId,
    task: taskId,
    person: ownerId,
    date: new Date("2026-08-24T12:00:00.000Z"),
    duration: 3600,
    status: TIMELOG_STATUS.INREVIEW,
    projectInfo: { approvers: [reviewerId] },
    ...overrides,
