        SpotTada: SpotTada,
        SpotTadaLg: SpotTadaLg,
        SpotTadaXL: SpotTadaXL,
        SpotTags: SpotTags,
        SpotTagsLg: SpotTagsLg,
        SpotTagsXL: SpotTagsXL,
        SpotTarget: SpotTarget,
        SpotTargetLg: SpotTargetLg,
        SpotTargetXL: SpotTargetXL,
        SpotTechnicalWriting: SpotTechnicalWriting,
        SpotTechnicalWritingLg: SpotTechnicalWritingLg,
        SpotTechnicalWritingXL: SpotTechnicalWritingXL,
        SpotTheme: SpotTheme,
        SpotThemeLg: SpotThemeLg,
        SpotThemeXL: SpotThemeXL,
        SpotThree: SpotThree,
        SpotTrophy: SpotTrophy,
        SpotTrophyLg: SpotTrophyLg,
        SpotTrophyXL: SpotTrophyXL,
        SpotTwo: SpotTwo,
        SpotUnlock: SpotUnlock,
        SpotUnlockLg: SpotUnlockLg,
        SpotUnlockXL: SpotUnlockXL,
        SpotUserAdd: SpotUserAdd,
        SpotUserAddLg: SpotUserAddLg,
        SpotUserAddXL: SpotUserAddXL,
        SpotWave: SpotWave,
        SpotWaveLg: SpotWaveLg,
        SpotWaveXL: SpotWaveXL,
    });

    function browserHelper(stacksIcons, stackSpots) {
        // Get all the SVG elements
        const items = document.querySelectorAll("svg[data-icon], svg[data-spot]");
        // Loop over them
        items.forEach(function (icon) {
            // Find an icon name in the format 'iconSomething'
            const iconName = icon.dataset["icon"] || icon.dataset["spot"] || "";
            let source = stacksIcons;
            if (icon.dataset["spot"]) {
                source = stackSpots;
            }
            // Get the SVG string from our object
            let svgStr = source[iconName];
            // Do we recognize this icon?
            if (!svgStr) {
                console.warn(
                    iconName +
                        " is not a Stacks icon or spot - did you spell something wrong? \n https://stackoverflow.design/product/resources/icons/#icon-set"
                );
                return;
            }
            // Replace classes
            const existingClass = icon.getAttribute("class");
            if (existingClass) {
                svgStr = svgStr.replace(/class="/, 'class="' + existingClass + " ");
            }
            // Create dom fragment
            // eslint-disable-next-line no-unsanitized/method
            const svgEl = document.createRange().createContextualFragment(svgStr);
            // Replace the existing SVG
            icon.parentNode?.replaceChild(svgEl, icon);
        });
    }

    // @ts-expect-error types are autogenerated via build script
    // automatically run if in the browser and not being imported
    if (typeof window !== "undefined" && window.document && window.document.currentScript) {
        browserHelper(Icons, Spots);
    }

    exports.Icons = Icons;
    exports.Spots = Spots;
    exports.browserHelper = browserHelper;
});
</file>

