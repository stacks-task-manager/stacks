function formatDate(iso?: string | Date): string {
    if (!iso) return "";
    const d = iso instanceof Date ? iso : new Date(iso as string);
    return d.toLocaleDateString(undefined, { weekday: "short", month: "short", day: "numeric" });
}

function TimesheetTabContent() {
