                            })
                        );
                    }, 200);
                },
                trigger: ":",
                selectTemplate: options.emojisSelectTemplate,
                menuShowMinLength: 1,
            });
        }

        if (options.assignees) {
            collections.push({
                values: (text: string, cb: (results: Array<{ key: string; value: string }>) => void) => {
                    if (assigneesDebounce.current) {
                        clearTimeout(assigneesDebounce.current);
