            background-color: $watermark-color;
            width: $watermark-width;
            height: calc($watermark-height + $watermark-space);
            border-radius: $watermark-border-radius;
        }

        &::after {
            content: "";
            position: absolute;
            top: 0;
            right: calc($watermark-space * -1);
            background-color: $watermark-color;
            width: $watermark-width;
            height: calc($watermark-height + 2 * $watermark-space);
            border-radius: $watermark-border-radius;
        }
    }
}

.#{$ns}-dark {
    #watermark {
        background-color: $dark-gray4;
    }
}
