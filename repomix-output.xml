      padding: 12px;
    }
    .turn.active { background: #172033; }
    .turn-title {
      display: flex;
      gap: 8px;
      align-items: center;
      margin-bottom: 6px;
    }
    .status {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      flex: 0 0 auto;
      background: var(--ok);
    }
    .status.error { background: var(--danger); }
    .message {
      font-weight: 600;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .meta, .preview {
      color: var(--muted);
      font-size: 12px;
      line-height: 1.4;
    }
    .main {
      min-width: 0;
      min-height: 0;
      overflow: auto;
      padding: 18px;
    }
    .empty {
      color: var(--muted);
      padding: 36px;
