                        onClick={() => handleToggleStackId(stack.id)}
                        shouldDismissPopover={singleSelection ? true : false}
                        data-testid={`stacks-menu-stack-${stack.id}`}
                    />
                );
            })}
            {canClear && (
                <>
                    <MenuDivider />
                    <MenuItem
                        text={translate("All stacks")}
                        icon="small-square"
                        onClick={() => onChange([])}
