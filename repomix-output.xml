    }
    .header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 16px;
    }
    h1 {
      margin: 0 0 6px;
      font-size: 20px;
      letter-spacing: 0;
    }
    h2 {
      font-size: 14px;
      margin: 18px 0 8px;
      color: var(--accent);
      letter-spacing: 0;
    }
    .grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
