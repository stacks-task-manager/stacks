<file path="packages/server/static/export/pdf/pdf-export.css">
:root {
    color-scheme: light;
    --ink: #172033;
    --muted: #64748b;
    --line: #dbe3ee;
    --soft: #f4f7fb;
    --brand: #5b5bd6;
    --brand-dark: #3535a8;
    --accent: #13a89e;
}
* {
    box-sizing: border-box;
}
html,
body {
    margin: 0;
    padding: 0;
    background: #fff;
    color: var(--ink);
    font-family: "Noto Sans", "Noto Sans CJK SC", "Noto Sans Arabic", Arial, sans-serif;
    font-size: 10.5pt;
    line-height: 1.48;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
}
body {
    overflow-wrap: anywhere;
}
.report {
    width: 100%;
}
.report-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(max-content, 38mm);
    gap: 8mm;
    align-items: end;
    padding: 0 0 8mm;
    border-bottom: 2px solid var(--brand);
    margin-bottom: 7mm;
}
.report-header > div:first-child {
    min-width: 0;
}
.brand {
    display: flex;
    align-items: center;
    gap: 3mm;
    color: var(--brand-dark);
    font-weight: 750;
    letter-spacing: 0.02em;
}
.brand svg {
    width: 8mm;
    height: 8mm;
}
.eyebrow {
    margin: 4mm 0 1.5mm;
    color: var(--brand);
    font-size: 8pt;
    font-weight: 750;
    letter-spacing: 0.11em;
    text-transform: uppercase;
}
h1 {
    margin: 0;
    max-width: 145mm;
    font-size: 24pt;
    line-height: 1.12;
    letter-spacing: -0.02em;
}
.header-meta {
    color: var(--muted);
    font-size: 8.5pt;
    text-align: end;
    white-space: nowrap;
}
.record {
    break-before: auto;
    break-after: auto;
    margin-bottom: 9mm;
}
.record + .record {
    break-before: page;
}
.record-hero {
    padding: 6mm 7mm;
    border-radius: 4mm;
    background: linear-gradient(125deg, #efefff 0%, #f8fbff 60%, #eafaf8 100%);
    border: 1px solid #dcdcf8;
    break-inside: avoid;
}
.report-person .record-hero,
.report-company .record-hero {
    border-inline-start: 3mm solid var(--brand);
}
.report-project .record-hero {
    border-inline-start: 3mm solid var(--accent);
}
.record-title {
    margin: 0;
    font-size: 19pt;
    line-height: 1.18;
}
.record-subtitle {
    margin: 1.5mm 0 0;
    color: var(--muted);
}
.badges,
.chips {
    display: flex;
    flex-wrap: wrap;
    gap: 1.8mm;
    margin-top: 3mm;
}
.badge,
.chip {
    display: inline-block;
    padding: 1mm 2.3mm;
    border-radius: 999px;
    background: #fff;
    border: 1px solid #cfd8e6;
    color: #34415a;
    font-size: 8.2pt;
    font-weight: 650;
}
.fact-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 3mm;
    margin-top: 4mm;
}
.fact {
    min-width: 0;
    padding: 3.2mm;
    border-radius: 2.5mm;
    background: var(--soft);
    break-inside: avoid;
}
.fact-label {
    display: block;
    color: var(--muted);
    font-size: 7.8pt;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
}
.fact-value {
    display: block;
    margin-top: 1mm;
    font-weight: 600;
    white-space: pre-wrap;
}
.section {
    margin-top: 5mm;
    padding: 5mm 6mm;
    border: 1px solid var(--line);
    border-radius: 3mm;
    break-inside: avoid;
}
.section-rich {
    break-inside: auto;
}
.section-title {
    margin: 0 0 3mm;
    color: var(--brand-dark);
    font-size: 11pt;
    letter-spacing: 0.01em;
}
.section-text {
    margin: 0;
    white-space: pre-wrap;
}
.data-table,
.rich-body table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
}
.data-table thead {
    display: table-header-group;
}
.data-table tr,
.rich-body tr {
    break-inside: avoid;
}
.data-table td,
.rich-body td,
.rich-body th {
    padding: 2.5mm;
    border: 1px solid var(--line);
    vertical-align: top;
    overflow-wrap: anywhere;
}
.table-label {
    display: block;
    color: var(--muted);
    font-size: 7.5pt;
    font-weight: 700;
    text-transform: uppercase;
}
.report-bookmark .data-table td:nth-child(2) {
    color: var(--brand-dark);
    font-family: "Noto Sans Mono", monospace;
    font-size: 8.5pt;
}
.rich-body {
    font-size: 10.8pt;
    line-height: 1.62;
}
.rich-body h1,
.rich-body h2,
.rich-body h3,
.rich-body h4 {
    margin: 6mm 0 2.5mm;
    break-after: avoid;
}
.rich-body h1 {
    font-size: 20pt;
}
.rich-body h2 {
    font-size: 16pt;
}
.rich-body h3 {
    font-size: 13pt;
}
.rich-body p,
.rich-body ul,
.rich-body ol,
.rich-body pre,
.rich-body blockquote {
    orphans: 3;
    widows: 3;
}
.rich-body blockquote {
    margin: 4mm 0;
    padding: 2mm 4mm;
    border-inline-start: 1.2mm solid var(--accent);
    background: #f0faf9;
}
.rich-body pre,
.rich-body code {
    font-family: "Noto Sans Mono", monospace;
    background: #f1f5f9;
}
.rich-body pre {
    padding: 4mm;
    border-radius: 2mm;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
}
.rich-body img {
    display: block;
    max-width: 100%;
    max-height: 220mm;
    margin: 4mm auto;
    object-fit: contain;
    break-inside: avoid;
}
a {
    color: var(--brand-dark);
    text-decoration: underline;
    overflow-wrap: anywhere;
}
.empty {
    color: var(--muted);
    font-style: italic;
}
.html-footer {
    margin-top: 8mm;
    padding-top: 3mm;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 8pt;
}
html[dir="rtl"] .report-header,
html[dir="rtl"] .record-hero,
html[dir="rtl"] .section,
html[dir="rtl"] .fact {
    text-align: right;
}
@media print {
    .html-footer {
        display: none;
    }
}
@media screen and (max-width: 720px) {
    body {
        padding: 20px;
    }
    .report-header,
    .fact-grid {
        grid-template-columns: 1fr;
    }
    .header-meta {
        text-align: start;
    }
}
</file>

