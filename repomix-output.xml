    });
}
fixtures.push(
    {
        id: "assign-only",
        locale: "en",
        request: 'Assign myself to the task named "Buy milk"',
        tool: "updateTask",
        expected: { assigneeUserIds: ["me"] },
        prohibited: ["title", "done", "todo", "duedate"],
    },
    {
        id: "unassigned-creation",
        locale: "en",
        request: 'Create a task called "Hello world" in Website',
