const BUTTON_SCOPE = Symbol("BUTTON");

type ButtonContextValue = {
    variant: "solid" | "outline" | "link";
    action: "primary" | "secondary" | "positive" | "negative";
    size: "xs" | "sm" | "md" | "lg" | "xl";
    isDisabled: boolean;
};

const ButtonContext = createContext<ButtonContextValue>({
    variant: "solid",
    action: "primary",
    size: "md",
