        <style>
            /*
     * Layout grids for this page only. Older stacks.min.css builds may not ship
     * d-grid / grid__* utilities; without these rules everything stacks as one column.
     */
            .landing-hero-grid {
                display: grid;
                gap: 3rem;
                align-items: center;
                grid-template-columns: 1fr;
            }
            .landing-two-col {
                display: grid;
                gap: 3rem;
                align-items: center;
                grid-template-columns: 1fr;
            }
            .landing-cols-3 {
                display: grid;
                gap: 2rem;
                grid-template-columns: 1fr;
            }
            .landing-cols-prod {
                display: grid;
                gap: 1.25rem;
                grid-template-columns: 1fr;
            }
            .landing-cols-highlights {
                display: grid;
                gap: 1.25rem;
                grid-template-columns: 1fr;
            }
            .landing-cols-testimonials {
                display: grid;
                gap: 1.5rem;
                grid-template-columns: 1fr;
            }
            .landing-pricing-grid {
                display: grid;
                gap: 2rem;
                align-items: start;
                grid-template-columns: 1fr;
            }
            .landing-footer-grid {
                display: grid;
                gap: 2rem;
                grid-template-columns: 1fr;
            }
            .landing-nav {
                z-index: 20;
                backdrop-filter: blur(14px);
                background: rgba(255, 255, 255, 0.92);
            }
            .landing-hero {
                position: relative;
                isolation: isolate;
            }
            .landing-hero::before {
                content: "";
                position: absolute;
                inset: 0;
                z-index: -1;
                opacity: 0.45;
                background: radial-gradient(circle at 75% 25%, #f4802440, transparent 30%),
                    radial-gradient(circle at 15% 80%, #5eba7d22, transparent 28%);
                animation: landingGlow 8s ease-in-out infinite alternate;
            }
            .product-preview {
                border: 1px solid #4a4f55;
                border-radius: 18px;
                overflow: hidden;
                background: #17191c;
                box-shadow: 0 30px 80px #0009;
                transform: perspective(1000px) rotateY(-4deg) rotateX(2deg);
                animation: landingFloat 6s ease-in-out infinite;
            }
            .preview-bar {
                display: flex;
                gap: 7px;
                padding: 14px 18px;
                border-bottom: 1px solid #343a40;
            }
            .preview-dot {
                width: 9px;
                height: 9px;
                border-radius: 50%;
                background: #f48024;
            }
            .preview-board {
                display: grid;
                grid-template-columns: repeat(3, 1fr);
                gap: 12px;
                padding: 18px;
                min-height: 300px;
            }
            .preview-column {
                padding: 12px;
                border-radius: 10px;
                background: #22262a;
            }
            .preview-card {
                height: 52px;
                margin-top: 10px;
                border: 1px solid #3b4045;
                border-radius: 8px;
                background: linear-gradient(135deg, #30363c, #25292d);
            }
            .preview-card.accent {
                border-left: 3px solid #f48024;
            }
            .illustration {
                min-height: 270px;
                display: grid;
                place-items: center;
                border-radius: 18px;
                border: 1px solid #e3e6e8;
                background: linear-gradient(145deg, #fff, #eef1f3);
                overflow: hidden;
            }
            .illustration svg {
                width: 78%;
                max-height: 230px;
            }
            .reveal {
                opacity: 0;
                transform: translateY(22px);
                transition: opacity 0.6s ease, transform 0.6s ease;
            }
            .reveal.is-visible {
                opacity: 1;
                transform: none;
            }
            @keyframes landingFloat {
                50% {
                    transform: perspective(1000px) rotateY(0) rotateX(0) translateY(-9px);
                }
            }
            @keyframes landingGlow {
                to {
                    opacity: 0.8;
                    transform: scale(1.06);
                }
            }
            @media (min-width: 40rem) {
                .landing-cols-prod {
                    grid-template-columns: repeat(2, 1fr);
                }
                .landing-cols-highlights {
                    grid-template-columns: repeat(2, 1fr);
                }
                .landing-footer-grid {
                    grid-template-columns: repeat(2, 1fr);
                }
            }
            @media (min-width: 48rem) {
                .landing-cols-3 {
                    grid-template-columns: repeat(3, 1fr);
                }
                .landing-cols-testimonials {
                    grid-template-columns: repeat(2, 1fr);
                }
            }
            @media (min-width: 64rem) {
                .landing-hero-grid,
                .landing-two-col {
                    grid-template-columns: 1fr 1fr;
                }
                .landing-cols-prod {
                    grid-template-columns: repeat(4, 1fr);
                }
                .landing-cols-highlights {
                    grid-template-columns: repeat(3, 1fr);
                }
                .landing-cols-testimonials {
                    grid-template-columns: repeat(3, 1fr);
                }
                .landing-pricing-grid {
                    grid-template-columns: repeat(3, 1fr);
                }
                .landing-footer-grid {
                    grid-template-columns: 2fr repeat(5, 1fr);
                }
            }
            @media (max-width: 39.99rem) {
                .preview-board {
                    grid-template-columns: 1fr 1fr;
                }
                .preview-column:last-child {
                    display: none;
                }
            }
            @media (prefers-reduced-motion: reduce) {
                *,
                *::before,
                *::after {
                    scroll-behavior: auto !important;
                    animation-duration: 0.01ms !important;
                    animation-iteration-count: 1 !important;
                    transition-duration: 0.01ms !important;
                }
                .reveal {
                    opacity: 1;
                    transform: none;
                }
                .product-preview {
                    transform: none;
                }
            }
        </style>
    </head>
