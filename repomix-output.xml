const LeftPane: React.FunctionComponent<{
    leftWidth: number | undefined;
    isSidebarVisible: boolean;
    setLeftWidth: (value: number) => void;
    children?: React.ReactNode;
}> = ({ children, leftWidth, isSidebarVisible, setLeftWidth }) => {
