# Email Service Dockerfile
FROM node:22-bullseye

RUN node -e 'const [major, minor] = process.versions.node.split(".").map(Number); if (major < 22 || (major === 22 && minor < 12)) process.exit(1)'

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /email-service

# Copy package files and install dependencies
COPY email-service/package.json ./
RUN yarn install --production

# Copy the bundled email service
COPY email-service/ .

# Remove any existing node_modules and reinstall to ensure compatibility
RUN rm -rf node_modules && yarn install --production

# AGPL-3.0 — ship LICENSE + NOTICE alongside the binary.
COPY --chmod=0444 email-service/legal/LICENSE /email-service/legal/LICENSE
COPY --chmod=0444 email-service/legal/NOTICE /email-service/legal/NOTICE

# Keep the queue worker unprivileged.
USER node

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD node -e "process.exit(0)"

# Start the email service
CMD ["node", "email-service.js"]
