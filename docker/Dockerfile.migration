# Migration Dockerfile
# This container runs database migrations before other services start

FROM node:22-alpine

RUN node -e 'const [major, minor] = process.versions.node.split(".").map(Number); if (major < 22 || (major === 22 && minor < 12)) process.exit(1)'

# Set working directory
WORKDIR /db

# Install dependencies for PostgreSQL client
RUN apk add --no-cache postgresql-client

# Full db/ artifact (package.json, vendor/stacks-types, migrations, …) from `yarn release:db`
COPY db ./
COPY provision-postgres-app-role.sh /db/provision-postgres-app-role.sh
COPY provision-postgres-app-role.sql /db/provision-postgres-app-role.sql
RUN chmod 0555 /db/provision-postgres-app-role.sh

# AGPL-3.0 — ship LICENSE + NOTICE alongside the binary.
COPY --chmod=0444 db/legal/LICENSE /db/legal/LICENSE
COPY --chmod=0444 db/legal/NOTICE /db/legal/NOTICE

RUN yarn install --production

# Migrations only need to read the release bundle and connect to PostgreSQL.
USER node

# Wait for database to be ready and run migrations
CMD ["sh", "-c", "while ! pg_isready -h $POSTGRES_HOST -p $POSTGRES_PORT -U $POSTGRES_USER; do echo 'Waiting for database...'; sleep 2; done && echo 'Database is ready, running migrations...' && npm run migrate"]
