{
    "name": "stacks-mono",
    "version": "1.0.0",
    "private": true,
    "workspaces": {
        "packages": [
            "packages/types",
            "packages/db",
            "packages/translations",
            "packages/license",
            "packages/app",
            "packages/mobile",
            "packages/server",
            "packages/email-service",
            "packages/locales-tui"
        ],
        "nohoist": [
            "@stacks/app/**",
            "@stacks/mobile/**"
        ]
    },
    "description": "",
    "keywords": [],
    "license": "AGPL-3.0-only",
    "author": "Cristian Barlutiu",
    "scripts": {
        "prune:workspaces": "node scripts/prune-nested-workspace-stacks.cjs",
        "postinstall": "yarn prune:workspaces",
        "install:deps": "yarn install --mode=skip-build",
        "setup:finalize": "yarn prune:workspaces",
        "setup": "yarn clean && yarn install:deps && yarn build:internal && yarn setup:finalize",
        "---- DEV ----": "",
        "dev": "yarn prune:workspaces && yarn workspace @stacks/types run compile && yarn workspace @stacks/translations run build && yarn workspace @stacks/db run compile && yarn workspace @stacks/license run build && concurrently -n libs,app,server -c cyan,green,magenta \"yarn dev:libs\" \"yarn dev:app:watch\" \"yarn workspace @stacks/server run dev\"",
        "dev:libs": "concurrently -n types,translations -c blue,yellow \"yarn workspace @stacks/types run dev\" \"yarn workspace @stacks/translations run dev\"",
        "dev:app": "yarn workspace @stacks/translations run build && yarn workspace @stacks/app run start",
        "dev:app:watch": "yarn workspace @stacks/app run start",
        "dev:server": "yarn prune:workspaces && yarn workspace @stacks/types run compile && yarn workspace @stacks/translations run build && yarn workspace @stacks/db run compile && yarn workspace @stacks/license run build && yarn workspace @stacks/server run dev",
        "dev:email": "yarn prune:workspaces && yarn workspace @stacks/types run compile && yarn workspace @stacks/db run compile && yarn workspace @stacks/email-service run dev",
        "dev:email:templates": "yarn workspace @stacks/types run compile && yarn workspace @stacks/email-service run dev:email",
        "ai:debug": "yarn workspace @stacks/server run ai:debug",
        "dev:locales": "yarn workspace @stacks/locales-tui start",
        "dev:mobile": "yarn workspace @stacks/mobile start",
        "reset-dev-password": "yarn workspace @stacks/db reset-password:dev",
        "build:internal": "yarn build:types && yarn install --mode=skip-build && yarn build:db && yarn build:license && yarn build:translations",
        "update:types:build": "yarn build:internal",
        "update:types": "yarn build:internal && yarn install",
        "---- BUILD ----": "",
        "build": "yarn install && yarn build:internal && yarn build:app && yarn build:server && yarn build:email-service",
        "build:types": "yarn workspace @stacks/types run build",
        "build:app": "yarn workspace @stacks/app run build",
        "build:server": "yarn workspace @stacks/server run bundle",
        "build:email-service": "yarn workspace @stacks/email-service run bundle",
        "build:db": "yarn workspace @stacks/db run build",
        "build:license": "yarn workspace @stacks/license run build",
        "build:translations": "yarn workspace @stacks/translations run build",
        "---- LINT / FORMAT ----": "",
        "format": "prettier --write \"**/*.{ts,tsx,js,jsx,cjs,mjs,json,md,yml,yaml,scss}\"",
        "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,cjs,mjs,json,md,yml,yaml,scss}\"",
        "lint": "yarn workspace @stacks/app run lint",
        "---- TEST ----": "",
        "test:server": "yarn workspace @stacks/server run test",
        "test:server:unit": "yarn workspace @stacks/server run test:unit",
        "test:security:dependency-patches": "node scripts/test-dependency-patches.cjs",
        "type-check:e2e": "yarn workspace @stacks/app tsc --project ../../tsconfig.playwright.json --noEmit",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:headed": "playwright test --headed",
        "---- RELEASE ----": "",
        "release": "yarn clean && yarn install && yarn build:internal && yarn build:app && yarn build:server && yarn build:email-service && yarn release:structure && yarn release:server && yarn release:app && yarn release:email-service && yarn release:db && yarn release:legal && yarn release:docker",
        "release:structure": "mkdir -p releases && mkdir -p releases/server && mkdir -p releases/server/app && mkdir -p releases/email-service && mkdir -p releases/db",
        "release:docker": "cp docker/* releases/ && cp docker/.env.example releases/",
        "release:app": "cp -r packages/app/build/* releases/server/app/",
        "release:server": "cp -R packages/server/dist/* releases/server/ && cp packages/server/public.pem releases/server/",
        "release:email-service": "cp -R packages/email-service/dist/* releases/email-service/",
        "release:db": "cp -R packages/db/build/. releases/db/",
        "release:legal": "mkdir -p releases/server/legal releases/email-service/legal releases/db/legal && cp LICENSE NOTICE releases/server/legal/ && cp LICENSE NOTICE releases/email-service/legal/ && cp LICENSE NOTICE releases/db/legal/ && cp LICENSE NOTICE releases/",
        "release:zip": "cd releases && zip -r ../stacks-teams.zip . && cd ..",
        "----- PUBLISH -----": "",
        "publish": "node scripts/publish-release.mjs",
        "----- LOCAL RELEASE RUN -----": "",
        "run:copy": "cp packages/server/license.key releases",
        "run:docker": "cd releases && docker-compose up --build",
        "----- CLEANUP -----": "",
        "clean": "bash scripts/clean.sh",
        "test:ai:model": "yarn workspace @stacks/server ai:evaluate"
    },
    "devDependencies": {
        "@playwright/test": "^1.40.0",
        "@types/node": "^26.6.5",
        "braces": "^3.0.3",
        "concurrently": "^10.0.3",
        "date-fns": "^4.1.0",
        "node-forge": "^1",
        "prettier": "^3.9.10",
        "prompts": "^2.4.2"
    },
    "packageManager": "yarn@3.6.4",
    "engines": {
        "node": ">=22.12.0"
    },
    "resolutions": {
        "proxy-addr": "^2.0.8",
        "shell-quote": "^1.8.4",
        "tar": "^7.5.19",
        "browserslist": "^4.28.7",
        "undici": "^6.28.1",
        "@xmldom/xmldom@npm:^0.9.10": "npm:^0.9.12",
        "postcss": "^8.5.18",
        "sharp": "^0.35.5",
        "source-map-js": "^1.2.2",
        "js-cookie": "^3.0.7",
        "@tiptap/extension-link@2.10.3": "npm:2.10.4",
        "@ai-sdk/provider-utils@4.0.29": "npm:4.0.33",
        "body-parser@~1.20.3": "npm:1.20.6",
        "brace-expansion@^1.1.7": "npm:1.1.21",
        "decode-uri-component@^0.2.2": "npm:0.5.0",
        "ip-address@^10.2.0": "npm:10.7.1",
        "moment@^2.29.4": "npm:2.31.0",
        "postcss-selector-parser@^7.1.1": "npm:7.1.6",
        "qs@^6.14.0": "npm:6.16.0",
        "qs@^6.15.2": "npm:6.16.0",
        "qs@~6.14.0": "npm:6.16.0",
        "uuid@^7.0.3": "npm:11.1.1",
        "node-forge@^1.3.3": "patch:node-forge@npm%3A1.4.0#./.yarn/patches/node-forge-npm-1.4.0-646822c506.patch",
        "node-forge@^1": "patch:node-forge@npm%3A1.4.0#./.yarn/patches/node-forge-npm-1.4.0-646822c506.patch",
        "braces@^3.0.3": "patch:braces@npm%3A3.0.3#./.yarn/patches/braces-npm-3.0.3-582c14023c.patch",
        "braces@~3.0.2": "patch:braces@npm%3A3.0.3#./.yarn/patches/braces-npm-3.0.3-582c14023c.patch",
        "@tiptap/core@^2.0.0": "npm:2.27.3",
        "vite@npm:^6.0.0 || ^7.0.0 || ^8.0.0": "npm:8.0.16",
        "websocket-driver@npm:>=0.5.1": "npm:0.7.5",
        "websocket-driver@npm:^0.7.4": "npm:0.7.5",
        "http-proxy-middleware@npm:^2.0.3": "npm:2.0.10",
        "launch-editor@npm:^2.6.0": "npm:2.14.1",
        "svgo@npm:^3.0.2": "npm:3.3.5",
        "svgo@npm:^4.0.1": "npm:4.1.0",
        "serialize-javascript@^6.0.2": "npm:7.1.2",
        "webpack-dev-middleware@npm:^7.4.2": "npm:7.4.6"
    }
}
